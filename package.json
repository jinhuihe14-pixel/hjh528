{
  "name": "card-game-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=@game/client",
    "dev:server": "npm run start:dev --workspace=@game/server",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:shared": "npm run build --workspace=@game/shared",
    "build:server": "npm run build --workspace=@game/server",
    "build:client": "npm run build --workspace=@game/client",
    "build": "npm run build:shared && npm run build:server && npm run build:client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  }
}
